# ---------------------------------------------------------------------------
# Vorlage für die .env neben der docker-compose.yml auf dem QNAP.
#
#   cp .env.example .env    und danach die Werte ausfüllen.
#
# Diese Datei enthält Geheimnisse und gehört NIEMALS ins Git-Repository.
# ---------------------------------------------------------------------------

# Signiert die Sitzungs-Cookies. Mindestens 32 Zeichen.
# Erzeugen mit:  openssl rand -base64 48
SESSION_SECRET=

# Nur für die allererste Anmeldung nötig. Ein beliebiger, schwer zu erratender
# Wert. Nach dem Anlegen des ersten Kontos kann die Zeile gelöscht werden.
# Erzeugen mit:  openssl rand -hex 16
SETUP_TOKEN=

# Aus dem Cloudflare-Dashboard: Zero Trust → Networks → Tunnels → Token kopieren.
TUNNEL_TOKEN=

# Pfade auf dem NAS. Beide Ordner vorher in der File Station anlegen.
DATA_PATH=/share/Container/manager/data
STORAGE_PATH=/share/Dokumente/Manager

# Besitzer der obigen Ordner. Auf dem NAS ermitteln mit:  id <benutzername>
PUID=1000
PGID=1000
