# ---------------------------------------------------------------------------
# Lokale Entwicklung
#
#   cp .env.example apps/api/.env
#
# Für den Betrieb auf dem QNAP gilt stattdessen infra/.env.example.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# Relativ zum Verzeichnis apps/api – beide Ordner sind in .gitignore.
DB_DIR=./data
STORAGE_DIR=./storage

# Der Vite-Entwicklungsserver läuft auf diesem Port.
APP_ORIGIN=http://localhost:5173

# Lokal keine Cookie-Domain setzen: localhost verträgt keine Punkt-Domains.
# COOKIE_DOMAIN=

SESSION_SECRET=lokales-entwicklungs-geheimnis-mindestens-32-zeichen
SESSION_DAYS=90

# Für die Ersteinrichtung im Browser.
SETUP_TOKEN=lokal-setup-token

LOG_LEVEL=debug
